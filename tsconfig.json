{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Node 24",
  "_version": "24.0.0",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "lib": [
      "es2024",
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}